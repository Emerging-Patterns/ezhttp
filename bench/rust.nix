  mainRsText = ''
//! In-process ureq client and hyper server for ezhttp benches.
//! Timed loops stay inside this process. Disk reads happen before Instant.

use std::convert::Infallible;
use std::env;
use std::fs;
use std::io::Read;
use std::net::SocketAddr;
use std::process;
use std::sync::Arc;
use std::time::{Duration, Instant};
use ureq::OrAnyStatus;

use bytes::Bytes;
use http_body_util::{BodyExt, Full};
use hyper::body::Incoming;
use hyper::server::conn::http1;
use hyper::service::service_fn;
use hyper::{Request, Response};
use hyper_util::rt::TokioIo;
use tokio::net::TcpListener;

struct Fx {
    text: Vec<u8>,
    raw: Vec<u8>,
    small: Vec<u8>,
    medium: Vec<u8>,
}

fn die(msg: &str) -> ! {
    eprintln!("{msg}");
    process::exit(1);
}

fn read_bytes(path: &str) -> Vec<u8> {
    fs::read(path).unwrap_or_else(|err| die(&format!("read {path}: {err}")))
}

fn write_bytes(path: &str, data: &[u8]) {
    fs::write(path, data).unwrap_or_else(|err| die(&format!("write {path}: {err}")));
}

fn show_ms(ms: u128, sum: u64, bytes: usize, n: u64) {
    println!("MS {ms} SUM {sum} BY {bytes} N {n}");
}

fn agent() -> ureq::Agent {
    ureq::AgentBuilder::new()
        .timeout(Duration::from_secs(60))
        .max_idle_connections(0)
        .redirects(0)
        .build()
}

fn take(resp: ureq::Response) -> (u16, Vec<u8>) {
    let status = resp.status();
    let mut buf = Vec::new();
    resp.into_reader()
        .read_to_end(&mut buf)
        .unwrap_or_else(|err| die(&format!("read body: {err}")));
    (status, buf)
}

fn http_get(agent: &ureq::Agent, url: &str) -> (u16, Vec<u8>) {
    match agent
        .get(url)
        .set("Connection", "close")
        .call()
        .or_any_status()
    {
        Ok(resp) => take(resp),
        Err(err) => die(&format!("GET {url}: {err}")),
    }
}

fn http_post(agent: &ureq::Agent, url: &str, body: &[u8], ctype: &str) -> (u16, Vec<u8>) {
    match agent
        .post(url)
        .set("Connection", "close")
        .set("Content-Type", ctype)
        .send_bytes(body)
        .or_any_status()
    {
        Ok(resp) => take(resp),
        Err(err) => die(&format!("POST {url}: {err}")),
    }
}

fn write_exchange(path: &str, status: u16, body: &[u8]) {
    let mut out = format!("{status}\n").into_bytes();
    out.extend_from_slice(body);
    write_bytes(path, &out);
}

fn json_print(text: &str) -> Result<Vec<u8>, ()> {
    let value: serde_json::Value = serde_json::from_str(text).map_err(|_| ())?;
    serde_json::to_vec(&value).map_err(|_| ())
}

fn cmd_json_ok(src: &str, dst: &str) {
    let text = fs::read_to_string(src).unwrap_or_else(|err| die(&format!("read {src}: {err}")));
    match json_print(&text) {
        Ok(out) => write_bytes(dst, &out),
        Err(()) => die("json parse failed"),
    }
}

fn cmd_get(url: &str, dst: &str) {
    let (status, body) = http_get(&agent(), url);
    write_exchange(dst, status, &body);
}

fn cmd_post(url: &str, src: &str, dst: &str, ctype: &str) {
    let body = read_bytes(src);
    let (status, resp) = http_post(&agent(), url, &body, ctype);
    write_exchange(dst, status, &resp);
}

fn cmd_post_json(url: &str, src: &str, dst: &str) {
    let text = fs::read_to_string(src).unwrap_or_else(|err| die(&format!("read {src}: {err}")));
    let body = json_print(&text).unwrap_or_else(|()| die("json parse failed"));
    let (status, resp) = http_post(&agent(), url, &body, "application/json");
    write_exchange(dst, status, &resp);
}

fn bench_get(url: &str, n: u64) {
    let agent = agent();
    let mut sum: u64 = 0;
    let mut nbytes = 0usize;
    let t0 = Instant::now();
    for _ in 0..n {
        let (status, body) = http_get(&agent, url);
        nbytes = body.len();
        sum = sum.wrapping_add(status as u64).wrapping_add(body.len() as u64);
    }
    show_ms(t0.elapsed().as_millis(), sum, nbytes, n);
}

fn bench_get_json(url: &str, n: u64) {
    let agent = agent();
    let mut sum: u64 = 0;
    let mut nbytes = 0usize;
    let t0 = Instant::now();
    for _ in 0..n {
        let (status, body) = http_get(&agent, url);
        nbytes = body.len();
        let text = String::from_utf8_lossy(&body);
        let printed = json_print(&text).unwrap_or_default();
        sum = sum
            .wrapping_add(status as u64)
            .wrapping_add(printed.len() as u64)
            .wrapping_add(1);
    }
    show_ms(t0.elapsed().as_millis(), sum, nbytes, n);
}

fn bench_post(url: &str, src: &str, n: u64, ctype: &str) {
    let body = read_bytes(src);
    let nbytes = body.len();
    let agent = agent();
    let mut sum: u64 = 0;
    let t0 = Instant::now();
    for _ in 0..n {
        let (status, resp) = http_post(&agent, url, &body, ctype);
        sum = sum
            .wrapping_add(status as u64)
            .wrapping_add(resp.len() as u64);
    }
    show_ms(t0.elapsed().as_millis(), sum, nbytes, n);
}

fn bench_post_json(url: &str, src: &str, n: u64) {
    let text = fs::read_to_string(src).unwrap_or_else(|err| die(&format!("read {src}: {err}")));
    let nbytes = text.len();
    let agent = agent();
    let mut sum: u64 = 0;
    let t0 = Instant::now();
    for _ in 0..n {
        let printed = json_print(&text).unwrap_or_default();
        let (status, resp) = http_post(&agent, url, &printed, "application/json");
        sum = sum
            .wrapping_add(status as u64)
            .wrapping_add(resp.len() as u64)
            .wrapping_add(printed.len() as u64);
    }
    show_ms(t0.elapsed().as_millis(), sum, nbytes, n);
}

fn bad() -> (u16, &'static str, Vec<u8>) {
    (400, "text/plain; charset=utf-8", b"bad json".to_vec())
}

fn route(method: &str, path: &str, body: &[u8], fx: &Fx) -> (u16, &'static str, Vec<u8>) {
    match (method, path) {
        ("GET", "/text") => (200, "text/plain; charset=utf-8", fx.text.clone()),
        ("GET", "/bytes") => (200, "application/octet-stream", fx.raw.clone()),
        ("GET", "/json/small") => (200, "application/json", fx.small.clone()),
        ("GET", "/json/medium") => (200, "application/json", fx.medium.clone()),
        ("POST", "/text") => (200, "text/plain; charset=utf-8", body.to_vec()),
        ("POST", "/bytes") => (200, "application/octet-stream", body.to_vec()),
        ("POST", "/json/small") | ("POST", "/json/medium") => {
            let text = match std::str::from_utf8(body) {
                Ok(s) => s,
                Err(_) => return bad(),
            };
            match json_print(text) {
                Ok(out) => (200, "application/json", out),
                Err(()) => bad(),
            }
        }
        ("GET", _) | ("POST", _) => (404, "text/plain; charset=utf-8", b"missing".to_vec()),
        _ => (405, "text/plain; charset=utf-8", b"method".to_vec()),
    }
}

fn respond(status: u16, ctype: &str, body: Vec<u8>) -> Response<Full<Bytes>> {
    let len = body.len();
    Response::builder()
        .status(status)
        .header("content-type", ctype)
        .header("connection", "close")
        .header("content-length", len)
        .body(Full::new(Bytes::from(body)))
        .unwrap_or_else(|err| die(&format!("response: {err}")))
}

async fn handle(req: Request<Incoming>, fx: Arc<Fx>) -> Result<Response<Full<Bytes>>, Infallible> {
    let method = req.method().as_str().to_string();
    let path = req.uri().path().to_string();
    let collected = match req.collect().await {
        Ok(c) => c.to_bytes(),
        Err(_) => return Ok(respond(400, "text/plain; charset=utf-8", b"bad body".to_vec())),
    };
    let (status, ctype, body) = route(&method, &path, &collected, &fx);
    Ok(respond(status, ctype, body))
}

async fn serve(port: u16, fx: Arc<Fx>) {
    let addr = SocketAddr::from(([127, 0, 0, 1], port));
    let listener = TcpListener::bind(addr)
        .await
        .unwrap_or_else(|err| die(&format!("listen {port}: {err}")));
    loop {
        let (stream, _) = match listener.accept().await {
            Ok(pair) => pair,
            Err(_) => continue,
        };
        let fx = fx.clone();
        tokio::spawn(async move {
            let io = TokioIo::new(stream);
            let svc = service_fn(move |req| handle(req, fx.clone()));
            let _ = http1::Builder::new()
                .keep_alive(false)
                .serve_connection(io, svc)
                .await;
        });
    }
}

fn cmd_serve(port: u16, text: &str, raw: &str, small: &str, medium: &str) {
    let fx = Arc::new(Fx {
        text: read_bytes(text),
        raw: read_bytes(raw),
        small: read_bytes(small),
        medium: read_bytes(medium),
    });
    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .unwrap_or_else(|err| die(&format!("runtime: {err}")));
    runtime.block_on(serve(port, fx));
}

fn need_u64(text: &str) -> u64 {
    text.parse::<u64>().unwrap_or_else(|_| die(&format!("not a count: {text}")))
}

fn need_port(text: &str) -> u16 {
    text.parse::<u16>().unwrap_or_else(|_| die(&format!("not a port: {text}")))
}

fn main() {
    let args: Vec<String> = env::args().skip(1).collect();
    let cmd = args.first().map(String::as_str).unwrap_or("");
    let a = args.get(1).map(String::as_str).unwrap_or("");
    let b = args.get(2).map(String::as_str).unwrap_or("");
    let c = args.get(3).map(String::as_str).unwrap_or("");
    let d = args.get(4).map(String::as_str).unwrap_or("");
    let e = args.get(5).map(String::as_str).unwrap_or("");
    match cmd {
        "ping" => println!("pong"),
        "json-ok" => cmd_json_ok(a, b),
        "get" => cmd_get(a, b),
        "post" => cmd_post(a, b, c, "text/plain; charset=utf-8"),
        "post-bytes" => cmd_post(a, b, c, "application/octet-stream"),
        "post-json" => cmd_post_json(a, b, c),
        "bench-get" => bench_get(a, need_u64(b)),
        "bench-get-json" => bench_get_json(a, need_u64(b)),
        "bench-post" => bench_post(a, b, need_u64(c), "text/plain; charset=utf-8"),
        "bench-post-bytes" => bench_post(a, b, need_u64(c), "application/octet-stream"),
        "bench-post-json" => bench_post_json(a, b, need_u64(c)),
        "serve" => cmd_serve(need_port(a), b, c, d, e),
        "" => die("usage: ezhttp-rust-ref <cmd> …"),
        other => die(&format!("unknown command {other}")),
    }
}
'';

  cargoToml = pkgs.writeText "Cargo.toml" cargoTomlText;
