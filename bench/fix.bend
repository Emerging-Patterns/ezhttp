# small JSON object, about 1KB, including a non-ASCII city
def fix.small() -> String:
  "{\"api\":\"v1\",\"user\":{\"id\":42,\"name\":\"Ada Lukasiewicz\",\"roles\":[\"admin\",\"ops\"]},\"prefs\":{\"theme\":\"dark\",\"locale\":\"ja-JP\",\"flags\":{\"beta\":true,\"extra\":null}},\"nums\":[0,-1,3,1000000],\"tree\":{\"a\":{\"b\":{\"c\":[1,2,{\"d\":\"depth\"}]}}},\"note\":\"naive cafe\",\"city\":\"東京\",\"pad\":\"\"}"

